# Keep all secrets in Vercel Environment Variables or a local .env file.
# Existing server-side Supabase settings (already used by WallpaperHub):
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# BytePlus Translate - create AccessKey ID and Secret Access Key in BytePlus IAM.
# Keep these values server-side only. Never place them in frontend JavaScript.
BYTEPLUS_ACCESS_KEY_ID=
BYTEPLUS_SECRET_ACCESS_KEY=
BYTEPLUS_REGION=ap-singapore-1

# WallpaperHub stops new translations at this safe monthly cap (maximum 1,900,000).
# This leaves a buffer below BytePlus's documented 2,000,000-character free quota.
BYTEPLUS_MONTHLY_CHAR_CAP=1900000

# Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_MINI_APP_URL=https://YOUR-WALLPAPERHUB-DOMAIN/publish-telegram.html
