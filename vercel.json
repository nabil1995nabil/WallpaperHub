{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "*.html",
          "*.css",
          "*.js",
          "public/**",
          "api/**",
          "admin/**",
          "components/**",
          "css/**",
          "js/**",
          "assets/**"
        ]
      }
    },
    {
      "src": "api/unsplash.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/unsplash",
      "dest": "/api/unsplash.js"
    },
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}
